# Скопируйте файл в .env и правьте под своё окружение.
# Приложение читает переменные из окружения процесса; в CI значения
# задаются прямо в workflow, файл .env в git не попадает.

# --- backend ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Путь к файлу SQLite относительно корня backend/ либо :memory: для тестов
DATABASE_URL=./data/app.db

# --- frontend (Vite читает только переменные с префиксом VITE_) ---
VITE_API_URL=http://localhost:3000